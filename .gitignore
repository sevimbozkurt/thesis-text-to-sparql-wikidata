# ---------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------
.env
*.key

# ---------------------------------------------------------------
# Large derived data. All of it is regenerable from the scripts and
# the cached API/GPU responses; committing it would put ~800 MB of
# machine output into a repository whose purpose is to record the
# writing. Keep your own backup of these separately as git is NOT
# backing them up.
# ---------------------------------------------------------------
gold_results.json
consensus_results.json
final_fq17-generated_prompt_query_annotated.json
regen/official_gold_results.json
all_results.csv
preds_values.jsonl.gz
external/
literature/papers/
admin/*.pdf
results.pdf

# ---------------------------------------------------------------
# LaTeX build products: regenerated by latexmk on every build
# ---------------------------------------------------------------
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
thesis_latex/thesis.pdf

# ---------------------------------------------------------------
# Machine noise
# ---------------------------------------------------------------
__pycache__/
*.pyc
.DS_Store
._*
.docx_build/
.figures_png/

# Third-party checkout with its own .git — tracked as a stray "modified
# submodule" otherwise, which makes `git status` permanently dirty.
BLINK/
